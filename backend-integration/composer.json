{
  "name": "cultura-educa-360/pasaporte-andino-api",
  "description": "Pasaporte Andino — módulo turístico aditivo para Cultura Educa 360 (PHP 8.4)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-gd": "*",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": { "psr-4": { "PasaporteAndino\\": "src/" } },
  "autoload-dev": { "psr-4": { "PasaporteAndino\\Tests\\": "tests/" } },
  "config": { "sort-packages": true, "platform-check": true }
}
